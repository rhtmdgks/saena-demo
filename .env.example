# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://the-saena.kro.kr

# Analytics
NEXT_PUBLIC_GA_ID=G-W6LV22900R
NEXT_PUBLIC_GTM_ID=GTM-NFLHXXGK

# Admin Credentials (Change these in production!)
# Note: In production, use proper server-side authentication
ADMIN_EMAIL=admin@the-saena.ai
ADMIN_PASSWORD=Ahskfltk1!!

# API Keys (if needed)
# NEXT_PUBLIC_API_KEY=your_api_key_here

# Database (if needed)
# DATABASE_URL=your_database_url_here

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Service (if needed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password

# Payment Gateway (if needed)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHAT=false

# Rapid Seven bridge: server-only, fail-closed. Never prefix these with NEXT_PUBLIC_.
# Development backend may use loopback HTTP; application/session origin requires HTTPS.
# RAPID7_ORIGIN=http://127.0.0.1:8000
# RAPID7_APP_ORIGIN=https://localhost:3000
# RAPID7_PUBLIC_KEY_PEM=operator-supplied-public-RSA-key-with-escaped-newlines
# RAPID7_ISSUER=operator-configured-issuer
# RAPID7_AUDIENCE=operator-configured-audience
# RAPID7_TENANT_ID=synthetic-tenant
# RAPID7_MEMBERSHIPS_JSON={"synthetic-user":{"actorId":"synthetic-actor","tenantId":"synthetic-tenant","reportIds":["synthetic-report"]}}
# Optional observationIds per membership selects only operator-granted collections.
# Current Rapid7 observation endpoint implementation is pending its signed Action Contract.
# Do not enable observationIds until that endpoint exists and is independently validated.
# Example membership: {"synthetic-user":{"actorId":"synthetic-actor","tenantId":"synthetic-tenant","reportIds":[],"observationIds":["synthetic-collection"]}}
